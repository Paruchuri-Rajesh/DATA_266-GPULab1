      "n_evals": 8,
      "from_epoch": 30,
      "every": 2
    },
    "eval": {
      "max_images": null,
      "batch_size": 16,
      "pred_dir": "outputs"
    },
    "submit": {
      "csv": "submission.csv"
    },
    "variant": "V2_CONTINUE"
  },
  "checkpoints": {
    "G_AB": "checkpoints\\runs\\V2_CONTINUE\\G_AB.pt",
    "G_BA": "checkpoints\\runs\\V2_CONTINUE\\G_BA.pt",
    "D_A": "checkpoints\\runs\\V2_CONTINUE\\D_A.pt",
    "D_B": "checkpoints\\runs\\V2_CONTINUE\\D_B.pt"
  },
  "results_file": "checkpoints\\runs\\V2_CONTINUE\\metrics_train.json"
